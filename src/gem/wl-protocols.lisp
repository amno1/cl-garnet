;;; -*- Mode: LISP; Syntax: Common-Lisp; Package: GARNET-WL-PROTOCOLS; Base: 10 -*-
;;;
;;; Wayland protocols the Wayland backend uses beyond those Wayflan
;;; provides, generated by Wayflan from their XML in protocols/.
;;;

(defpackage :garnet-wl-protocols
  (:use :cl :wayflan-client)
  (:import-from :xyz.shunter.wayflan.client.scanner #:wl-include))

(in-package :garnet-wl-protocols)

;;; Cursor shapes by name, set by the compositor from its cursor theme.
(wl-include
 (asdf:system-relative-pathname :garnet "src/gem/protocols/cursor-shape-v1.xml")
 :export t)

;;; The scale the compositor would like a surface drawn at, which may be
;;; fractional; the buffer is then shown at the surface's logical size
;;; through wp_viewporter.
(wl-include
 (asdf:system-relative-pathname :garnet "src/gem/protocols/fractional-scale-v1.xml")
 :export t)
